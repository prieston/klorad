# Klorad Heritage — local env template.
# Copy to `.env.local` and fill in. Most values can be reused from
# `apps/campus/.env`, since Heritage shares the same database and auth tier.
#
# `lib/env.ts` validates these at boot. Missing required vars in development
# log a loud warning and fall back to safe placeholders so the app still
# starts; in production the validator throws.

# ── Boot-blocking ──────────────────────────────────────────────
# Postgres connection string used at runtime by Prisma.
DATABASE_URL="prisma://...accelerate-or-direct..."
# Direct connection used by migrations + Prisma Studio.
DIRECT_DATABASE_URL="postgresql://user:pass@host:port/db?sslmode=require"
# NextAuth session-token signing secret. >= 16 chars.
# Generate one with: openssl rand -base64 32
SECRET="please-change-me-to-a-long-random-string"

# NextAuth base URL. Heritage runs on 3005; the root `.env` defaults these to
# the editor on 3001, so every app overrides them in its own `.env.local`.
# Without the override, the Google/GitHub callback is built against 3001 and
# the sign-in round trip fails there. Also add
# http://localhost:3005/api/auth/callback/google to the OAuth client's
# authorised redirect URIs, or Google rejects the request before it returns.
NEXT_PUBLIC_APP_URL="http://localhost:3005"
NEXTAUTH_URL="http://localhost:3005"

# ── Optional features ─────────────────────────────────────────
# At-rest encryption for per-tenant secrets (via @klorad/secrets).
# Spec §5.8 / §9.1: a private AI key per tenant, encrypted.
SECRETS_KEY=""

# OAuth providers — at least one is required for curators to sign in.
# Same accounts as Campus.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# DigitalOcean Spaces — where ingested masters and delivery builds land.
# Heritage reaches this as soon as a curator uploads anything, so unlike
# Mobility it is effectively required past the scaffold stage.
#
# Residency note (§9.1): EU by default is a tender requirement, not a
# preference. Point this at an EU region (e.g. fra1/ams3), not a US one.
DO_SPACES_REGION=""
DO_SPACES_ENDPOINT=""
DO_SPACES_BUCKET=""
DO_SPACES_KEY=""
DO_SPACES_SECRET=""

# Web Push (VAPID) — gates visitor notifications (§7.1.9, reused from
# Campus). Generate once with:
#   npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
