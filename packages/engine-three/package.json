{
  "name": "@klorad/engine-three",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./plugins/*": {
      "types": "./dist/plugins/*.d.ts",
      "import": "./dist/plugins/*.js",
      "default": "./dist/plugins/*.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "default": "./dist/utils/*.js"
    },
    "./viewer": {
      "types": "./dist/viewer/heritage-viewer.d.ts",
      "import": "./dist/viewer/heritage-viewer.js",
      "default": "./dist/viewer/heritage-viewer.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@mui/material": ">=5",
    "@react-spring/three": ">=9.7.0",
    "@react-three/fiber": ">=9.0.0",
    "@react-three/drei": ">=10.0.0",
    "@react-three/rapier": ">=1",
    "@react-three/xr": ">=6",
    "three": ">=0.170.0 <1"
  },
  "dependencies": {
    "@klorad/core": "workspace:*",
    "@klorad/ui": "workspace:*",
    "@klorad/engine-cesium": "workspace:*",
    "@types/node": "^20.11.30",
    "@types/three": "^0.170.0",
    "@types/uuid": "^9.0.8",
    "3d-tiles-renderer": "^0.4.7"
  },
  "devDependencies": {},
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "tsup",
    "dev": "tsup --watch"
  }
}
